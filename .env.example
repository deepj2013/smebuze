# Copy to .env and set values. Used by API and docker-compose.production.yml
JWT_SECRET=change-me-use-openssl-rand-base64-32
# Stay-signed-in token lifetime (default 30d). Short session when user unchecks “Stay signed in”:
# JWT_EXPIRES_IN=30d
# JWT_SESSION_EXPIRES_IN=12h
DB_PASSWORD=change-me-secure-postgres-password

# API bind address. Production on a shared VPS: 127.0.0.1 (nginx proxies). Docker: 0.0.0.0
# HOST=127.0.0.1
# PORT=3000

# Database name (API default is smebuze). If you created the DB with another name (e.g. smebuzz), set it here:
# DB_NAME=smebuzz
DB_NAME=smebuze

# Never enable on production. Local throwaway DBs only.
# TYPEORM_SYNC=true

# WhatsApp via AmeeraIT sendtemplate (optional). Do not put keys in the website.
WHATSAPP_AMEERA_URL=https://login.ameerait.com/api/sendtemplate.php
WHATSAPP_AMEERA_LICENSE=
WHATSAPP_AMEERA_API_KEY=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_INVOICE=
WHATSAPP_TEMPLATE_QUOTATION=
WHATSAPP_TEMPLATE_ORDER=

# Ice Crest seed login (npm run seed:ice-crest). Forgot-password mail is sent to this inbox.
ICE_CREST_ADMIN_EMAIL=info@icecrest.in
# ICE_CREST_ADMIN_PASSWORD=Password123

# Public API URL for webhooks and logo URLs on printed invoices (no trailing slash)
API_PUBLIC_URL=http://localhost:3000

# Allow public Ice Crest website form (comma-separated origins, or * for dev)
CORS_ORIGIN=*

# Website (.env.local in apps/website)
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://smebuze.com

# Hostinger SMTP (forgot password, OTP, welcome, invites). Do not commit MAIL_PASS.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=support@smebuze.com
MAIL_PASS=
MAIL_FROM="SMEBUZE <support@smebuze.com>"

# Used in email buttons and printed invoice pay links (no trailing slash)
FRONTEND_URL=http://localhost:3001
APP_URL=http://localhost:3001

# Razorpay keys are per workspace: Organization → Scan to pay. Secrets are encrypted with JWT_SECRET.
# That money goes to the tenant. SMEBUZE subscription billing uses the platform keys below.

# Platform subscription + mall collect + commerce add-ons (SMEBUZE Razorpay account)
# How to generate: docs/ECOSYSTEM_BILLING_SETUP.md → Razorpay dashboard → API Keys + Webhooks
# Razorpay dashboard webhook: POST {API_PUBLIC_URL}/api/v1/billing/razorpay/webhook
#   Events: payment.captured, order.paid (handles subscription, mall_order, commerce_addon)
# PhonePe callback URL: {API_PUBLIC_URL}/api/v1/billing/phonepe/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# When Razorpay is not live: tenants see these on /billing and upload payment screenshots for super-admin approval
PLATFORM_BILLING_PAYEE_NAME=SMEBUZE
PLATFORM_BILLING_UPI=smebuze@upi
PLATFORM_BILLING_BANK_NAME=
PLATFORM_BILLING_BANK_BRANCH=
PLATFORM_BILLING_ACCOUNT_NO=
PLATFORM_BILLING_IFSC=
# Path or full URL to a static QR image (e.g. /uploads/platform-billing-qr.png on the API server)
PLATFORM_BILLING_QR_URL=
PLATFORM_BILLING_NOTE=Pay the amount shown, then upload your UPI/bank payment screenshot. We activate within one business day.

# Tier 8 commerce add-on prices (INR / month)
ADDON_ONLINE_SHOP_RUPEES=299
ADDON_MALL_LISTING_RUPEES=199
# Weekly settlement builder. Default cadence is daily T+1 (~03:00). Set weekly for Sunday-only.
MARKETPLACE_SETTLEMENT_CRON=1
MARKETPLACE_SETTLEMENT_CADENCE=t1
# AUTO_MIGRATE=0  # skip SQL on API boot (npm run db:migrate still works)
# MARKETPLACE_SETTLEMENT_FORCE=1

PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox

# Google sign-in (web OAuth client). Redirect URI:
# {API_PUBLIC_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
