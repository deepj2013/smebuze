# Copy to .env and set values. Used by API and docker-compose.production.yml
JWT_SECRET=change-me-use-openssl-rand-base64-32
DB_PASSWORD=change-me-secure-postgres-password

# API bind address. Production on a shared VPS: 127.0.0.1 (nginx proxies). Docker: 0.0.0.0
# HOST=127.0.0.1
# PORT=3000

# Database name (API default is smebuze). If you created the DB with another name (e.g. smebuzz), set it here:
# DB_NAME=smebuzz
DB_NAME=smebuze

# WhatsApp via AmeeraIT sendtemplate (optional). Do not put keys in the website.
WHATSAPP_AMEERA_URL=https://login.ameerait.com/api/sendtemplate.php
WHATSAPP_AMEERA_LICENSE=
WHATSAPP_AMEERA_API_KEY=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_INVOICE=
WHATSAPP_TEMPLATE_QUOTATION=
WHATSAPP_TEMPLATE_ORDER=

# Ice Crest seed login (npm run seed:ice-crest). Forgot-password mail is sent to this inbox.
ICE_CREST_ADMIN_EMAIL=info@icecrest.in
# ICE_CREST_ADMIN_PASSWORD=Password123

# Public API URL for webhooks and logo URLs on printed invoices (no trailing slash)
API_PUBLIC_URL=http://localhost:3000

# Allow public Ice Crest website form (comma-separated origins, or * for dev)
CORS_ORIGIN=*

# Website (.env.local in apps/website)
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://smebuze.com

# Hostinger SMTP (forgot password, OTP, welcome, invites). Do not commit MAIL_PASS.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=support@smebuze.com
MAIL_PASS=
MAIL_FROM="SMEBUZE <support@smebuze.com>"

# Used in email buttons and printed invoice pay links (no trailing slash)
FRONTEND_URL=http://localhost:3001
APP_URL=http://localhost:3001

# Razorpay keys are per workspace: Organization → Scan to pay. Secrets are encrypted with JWT_SECRET.
# That money goes to the tenant. SMEBUZE subscription billing uses the platform keys below.

# Platform subscription (SMEBUZE collects this after the 7-day trial)
# Razorpay dashboard webhook: POST {API_PUBLIC_URL}/api/v1/billing/razorpay/webhook
# PhonePe callback URL: {API_PUBLIC_URL}/api/v1/billing/phonepe/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox
